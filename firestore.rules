// PalengkeGo Firestore security rules.
//
// This file mirrors the de-facto ERD implemented by the Flutter repositories:
//   users/{uid}                        — role holder ('customer' | 'vendor' | 'admin')
//   vendorStalls/{stallId}              — stall id == owner uid; doc carries ownerUid
//   vendorStalls/{stallId}/products/{productId}
//   orders/{orderId}                    — customerUid, stallId, status, paymentStatus
//   orders/{orderId}/statusHistory/{historyId}
//   ratings/{ratingId}                  — vendorId, customerId, orderId
//   customerProfiles/{uid},  customerProfiles/{uid}/addresses/{addressId}
//   kycSubmissions/{kycId}              — stallHolderId (== vendor uid)
//   licenseRenewals/{renewalId}         — stallId, vendorUid
//   salesSummary/{stallId}/daily/{date} — write-only via Cloud Functions (admin)
//   systemAnnouncements/{announcementId}
//
// Principle: NEVER allow `request.auth != null` as a blanket rule.
// Every write is scoped to a collection + owner/role check; privileged
// mutations (stock, status transitions, rating aggregates, sales rollup)
// run in Cloud Functions, which bypass these rules via Admin SDK.
//
// Trusted-path-only collections (audit 2026-08-23 H3/M2): `orders` and
// `ratings` have NO client create OR update. Every order mutation flows
// through the placeOrder/updateOrderStatus/cancelOrder callables (state
// machine, audit log, stock restock) and every review through addReview
// (aggregate recomputed in the same transaction). Direct client writes
// would bypass all of that, so they are default-denied.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function uid() {
      return request.auth.uid;
    }

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isRole(roleId, userId) {
      return signedIn()
        && userDoc(userId).role == roleId;
    }

    function isAdmin() {
      return isRole('admin', uid());
    }

    // Role values: registration writes enum name 'vendor'; legacy writes used
    // 'stall holder'. Accept both to stay compatible with existing documents.
    function isVendor() {
      return signedIn()
        && userDoc(uid()).role in ['vendor', 'stall holder'];
    }

    // True when the signed-in user owns the given stall (via ownerUid).
    function ownsStall(stallId) {
      return signedIn()
        && get(/databases/$(database)/documents/vendorStalls/$(stallId))
             .data.ownerUid == uid();
    }

    // True when the user document is neither blocked nor a scam archive.
    function unblocked(userId) {
      return userDoc(userId).isBlocked == false;
    }

    // ── users/{uid} ────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      // Self-registration only; on create the caller may NOT assert an
      // elevated role or a blocked/verified state.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.isBlocked == false
        && request.resource.data.isVerified == false;
      allow update: if signedIn()
        && request.auth.uid == uid
        // Role and account flags may not be changed by the client — only
        // admins/functions may. The diff must contain no protected keys.
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(
               ['role', 'isBlocked', 'isVerified', 'email']
             );
      allow delete: if false;
    }

    // ── vendorStalls ───────────────────────────────────────────────────────────

    match /vendorStalls/{stallId} {
      // Public catalog data (name, category, location, rating) has no PII.
      allow read: if true;
      allow create: if signedIn()
        && unblocked(uid())
        && request.auth.uid == stallId               // stall id == owner uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isKYCApproved == false;
      allow update: if signedIn()
        && ownsStall(stallId)
        && unblocked(uid())
        // ownerUid must remain immutable
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['ownerUid']) == false
        // Audit 2026-08-23 H1: privileged fields are written ONLY by the
        // trusted callables (approveKyc, approveRenewal) and the addReview
        // aggregate. Without this deny-list a vendor could self-approve KYC,
        // grant themselves an active license, or inflate their own rating.
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(
               ['isKYCApproved', 'kycStatus', 'licenseStatus',
                'licenseExpiryDate', 'averageRating', 'totalRatings',
                'stallNumber', 'floorNumber', 'section']) == false;
      allow delete: if false;

      match /products/{productId} {
        allow read: if true;
        // Only the stall owner can maintain their own catalog. Audit
        // 2026-08-23 M3: price/stock are validated on CREATE too (the update
        // path already checked stock) — a negative price would otherwise flow
        // into server-side order totals and poison revenue math.
        allow create: if signedIn()
          && ownsStall(stallId)
          && unblocked(uid())
          && request.resource.data.vendorId == stallId
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stockQuantity is number
          && request.resource.data.stockQuantity >= 0;
        allow update: if signedIn()
          && ownsStall(stallId)
          && unblocked(uid())
          && request.resource.data.vendorId == stallId
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stockQuantity is number
          && request.resource.data.stockQuantity >= 0;
        allow delete: if signedIn() && ownsStall(stallId) && unblocked(uid());
      }
    }

    // ── sales summary (trusted rollup) ────────────────────────────────────────
    // Written exclusively by the trusted backend (functions/src/sales.ts and
    // the Supabase transition rollup) at `salesSummary/{stallId}/daily/{date}`
    // — the SAME path the vendor earnings screen reads. Audit 2026-08-23 H2:
    // an earlier version of this file guarded a non-existent subcollection
    // path (vendorStalls/{stallId}/salesSummary), so vendor reads of the real
    // top-level collection were default-denied in production.
    match /salesSummary/{stallId}/daily/{date} {
      allow read: if signedIn() && ownsStall(stallId);
      allow write: if false;
    }

    // ── cart ───────────────────────────────────────────────────────────────────

    // carts/{uid} holds one document per user with an 'items' array.
    // Only the owner reads or writes their own cart; nothing is shared.
    match /carts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── orders ─────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      // The customer who owns the order, or the vendor who owns the stall
      // it was placed at, may read it. Both sides power their own screens.
      allow read: if signedIn()
        && (resource.data.customerUid == uid()
            || ownsStall(resource.data.stallId));

      // Order creation AND updates are TRUSTED-PATH ONLY (audit 2026-08-23
      // H3): the placeOrder / updateOrderStatus / cancelOrder callables
      // recompute prices, fees and stock server-side, enforce the status
      // graph and the 5-minute cancel window, restock on cancel/reject, and
      // stamp the immutable statusHistory audit log with the real acting uid.
      // A client-side update bypassed ALL of that: it could jump the state
      // machine (pending -> completed), rewrite placedAt/stallId, cancel
      // without restocking, and leave no audit entry. Default-deny both.
      //
      // (No `allow create` / `allow update` statement means default-deny.)

      // Deletes are never client-side.
      allow delete: if false;

      match /statusHistory/{historyId} {
        // History docs carry no customerUid/stallId of their own — authorize
        // through the PARENT order (one extra get per read).
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid
                == request.auth.uid
              || ownsStall(
                  get(/databases/$(database)/documents/orders/$(orderId)).data.stallId));
        // Append-only audit log. Clients never write it directly — every
        // entry is created by a Cloud Function (placeOrder, applyStatus
        // Transition, createRefund) via the Admin SDK, which stamps the real
        // acting uid. This kills the `changedBy: 'system'` forgery vector:
        // no client can forge an audit entry.
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── ratings ────────────────────────────────────────────────────────────────

    match /ratings/{ratingId} {
      allow read: if signedIn();
      // Review creation is TRUSTED-PATH ONLY (audit 2026-08-23 M2): the
      // addReview callable verifies the customer owns a completed order for
      // the stall, enforces one review per (order, customer) via the
      // deterministic `{orderId}_{uid}` doc id created inside a transaction,
      // and recomputes the stall rating aggregate in the SAME transaction.
      // A direct client write would create the review doc WITHOUT touching
      // the aggregate (averageRating/totalRatings drift), so it is denied.
      allow update: if false;
      allow delete: if false;
    }

    // ── system announcements ────────────────────────────────────────────────────
    // Public broadcasts rendered in the apps' home carousels (no PII).
    // Only admins publish; the Admin portal calls via its own auth, and
    // privileged mutation stays rules-side because there is no money or
    // state machine involved.
    match /systemAnnouncements/{announcementId} {
      allow read: if true;
      allow create, update: if signedIn() && isAdmin();
      allow delete: if signedIn() && isAdmin();
    }

    // ── admin audit log ─────────────────────────────────────────────────────────
    // Written exclusively by the trusted admin callables (approveKyc,
    // approveRenewal, setAccountBlocked); readable by admins for the portal's
    // audit screen.
    match /adminActions/{actionId} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }

    // ── customer profiles ──────────────────────────────────────────────────────

    match /customerProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── KYC submissions ────────────────────────────────────────────────────────

    match /kycSubmissions/{kycId} {
      allow read: if signedIn()
        && (resource.data.stallHolderId == request.auth.uid
            || isAdmin());
      // Audit 2026-08-23 H4: CUSTOMERS apply (onboarding starts from a
      // customer account — requiring the vendor role here was a
      // chicken-and-egg dead end). Approval via the approveKyc callable is
      // the single atomic moment that promotes the role and creates the
      // stall doc. Review fields cannot be pre-stamped by the applicant.
      allow create: if signedIn()
        && unblocked(uid())
        && request.resource.data.stallHolderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data);
      allow update: if false; // reviewed only by functions/admins
      allow delete: if false;

      // No client subcollections under KYC.
    }

    // ── license renewals ───────────────────────────────────────────────────────

    match /licenseRenewals/{renewalId} {
      allow read: if signedIn()
        && (resource.data.vendorUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && isVendor()
        && unblocked(uid())
        && request.resource.data.vendorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data);
      allow update: if false; // only functions/admins
      allow delete: if false;
    }
  }
}